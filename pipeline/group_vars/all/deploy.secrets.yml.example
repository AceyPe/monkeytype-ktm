---
# Same keys as deploy.secrets.yml — use as a template when recreating the file.
# After editing real values: ansible-vault encrypt group_vars/all/deploy.secrets.yml

deploy_host: "your.server.ip.or.dns"
deploy_user: "ubuntu"
deploy_ssh_key_path: "/absolute/path/to/private.key"
deploy_local_path: "/absolute/path/to/monkeytype-ktm"
deploy_remote_path: "/home/ubuntu/webapp"
deploy_remote_base: "/home/ubuntu"
pm2_app_name: "my-app"
# Optional: full path if pm2 still not found after nvm/bashrc (output of `which pm2` on the server).
# pm2_executable: "/home/ubuntu/.nvm/versions/node/v22.0.0/bin/pm2"
# Optional: set true to run the cluster task (usually mutually exclusive with a single named instance).
# pm2_start_cluster: false
